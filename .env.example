# Copy to .env (gitignored). Prefer secrets only in .env / secret manager.
#
# Mapped from competitive-agent/backend/.env style:

# Preferred names used by pi-ai openai provider auth
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Aliases accepted by scripts/smoke_live_model.py (old-repo names)
MODEL_PROVIDER=openai
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
MODEL_CONTEXT_WINDOW_TOKENS=200000

# Search capability packages (FEATURES v0.1.11) — secrets only in real .env
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com

ANYSEARCH_API_KEY=
ANYSEARCH_API_URL=https://api.anysearch.com/mcp

GROK_API_KEY=
GROK_API_URL=
GROK_MODEL=

# Multi-LLM fallback (feature llm-fallback-observability-v1) — 全局单降级链。
# 逗号分隔 provider 名（按序轮转）；留空 = 直通单主模型。
LLM_FALLBACK_PROVIDERS=
# 1 = 禁用 fallback（直通）；默认启用（配合 LLM_FALLBACK_PROVIDERS）。
LLM_FALLBACK_DISABLED=0
# 首包探测超时（ms）；首包在超时内未到即切换下家。默认 60000。
LLM_FALLBACK_FIRST_PACKET_MS=60000

# RunJournal 落盘根目录（run_id = task_id；delete task 级联删除该目录）。
RUNS_ROOT=data/runs
