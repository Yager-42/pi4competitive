  "comments": [
    {
      "path": "competitive_app/src/competitive_app/application/evolution/skill_files.py",
      "content": "This new `to_thread` await introduces a cancellation point after the marker and (when applicable) scope have already been persisted. `CancelledError` derives from `BaseException`, so it bypasses the `except Exception` rollback block; if cancellation occurs here, the worker may still replace the manifest while `accept_candidate` exits without restoring the prior marker/scope, leaving the projections inconsistent. Ensure the worker operation is drained and cancellation is handled by the rollback path (or otherwise make the commit sequence cancellation-safe).",
      "existing_code": "        await asyncio.to_thread(_atomic_write, self._manifest, payload)",
      "start_line": 170,
      "end_line": 170,
      "category": "bug",
      "severity": "medium"
    },
    {
      "path": "tests/competitive_app/unit/sandbox/native/test_srt_linux.py",
      "content": "This successful wrap increments the module-global `_active_sandbox_count`, but the test never releases it. That leaves the shared sandbox cleanup state at +1 for subsequent tests (and can make `cleanup_bwrap_mount_points()` defer cleanup unexpectedly), so the test suite becomes order-dependent. Clean up the successful sandbox allocation in a `finally` block (or explicitly call the matching cleanup routine) after the assertions.",
      "existing_code": "    assert argv[0] == \"bwrap\"\n    index = argv.index(\"--preserve-fds\")\n    assert argv[index + 1] == \"7\"\n\n    before = srt_linux._active_sandbox_count",
      "start_line": 71,
      "end_line": 75,
      "category": "test",
      "severity": "medium"
    }
  ],
